# Cookie de sesión — NO pegues la cookie aquí si lleva comillas (rur="...").
# Usa el archivo instagram_cookie.txt (copia instagram_cookie.txt.example).

# Opcional si NO usas instagram_cookie.txt: solo el valor de sessionid
INSTAGRAM_SESSION_ID=tu_session_id_aqui

# Opcional
INSTAGRAM_CSRF_TOKEN=tu_csrftoken_aqui

# Ruta alternativa al archivo de cookie
# INSTAGRAM_COOKIE_FILE=instagram_cookie.txt

# Timeout entre peticiones de instatouch (milisegundos)
INSTATOUCH_TIMEOUT_MS=2000

# Pausas adicionales en Python entre jobs
DELAY_BETWEEN_POSTS_SEC=1.5
DELAY_BETWEEN_COMMENT_JOBS_SEC=2.0

# Reintentos con backoff exponencial
MAX_RETRIES=3
